{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug day10_enterprise_agent",
            "request": "launch",
            "type": "debugpy",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/projects/day10_enterprise_agent/app",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/projects/day10_enterprise_agent/app"
            },
            "args": [
                "main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal"
        }
    ]
}